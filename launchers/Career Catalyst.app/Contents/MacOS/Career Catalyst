#!/bin/bash

STATE_DIR="$HOME/Library/Application Support/Career Catalyst"
CONFIG_FILE="$STATE_DIR/launcher.conf"

show_error() {
  osascript - "$1" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  display alert "Career Catalyst could not start" message (item 1 of argv) as critical
end run
APPLESCRIPT
}

if [ ! -f "$CONFIG_FILE" ]; then
  show_error "Launcher configuration is missing: $CONFIG_FILE"
  exit 1
fi

LAUNCHER_PATH="$(sed -n 's/^CAREER_CATALYST_LAUNCHER_PATH=//p' "$CONFIG_FILE" | head -n 1)"
if [ -z "$LAUNCHER_PATH" ] || [ ! -f "$LAUNCHER_PATH" ]; then
  show_error "The durable Career Catalyst launcher is unavailable: $LAUNCHER_PATH"
  exit 1
fi

CAREER_CATALYST_CONFIG_FILE="$CONFIG_FILE" exec /bin/bash "$LAUNCHER_PATH"
