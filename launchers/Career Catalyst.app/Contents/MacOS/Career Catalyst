#!/bin/bash

STATE_DIR="$HOME/Library/Application Support/Career Catalyst"
CONFIG_FILE="$STATE_DIR/launcher.conf"

show_error() {
  osascript - "$1" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  display alert "Career Catalyst could not start" message (item 1 of argv) as critical
end run
APPLESCRIPT
}

if [ ! -f "$CONFIG_FILE" ]; then
  show_error "Launcher configuration is missing: $CONFIG_FILE"
  exit 1
fi

LAUNCHER_PATH="$(sed -n 's/^CAREER_CATALYST_LAUNCHER_PATH=//p' "$CONFIG_FILE" | head -n 1)"
if [ -z "$LAUNCHER_PATH" ] || [ ! -f "$LAUNCHER_PATH" ]; then
  show_error "The durable Career Catalyst launcher is unavailable: $LAUNCHER_PATH"
  exit 1
fi

APP_CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
COMMAND_PATH="$APP_CONTENTS/Resources/launch_career_catalyst.command"
if [ ! -x "$COMMAND_PATH" ]; then
  show_error "The durable Career Catalyst command is unavailable: $COMMAND_PATH"
  exit 1
fi

# Finder-launched app bundles do not inherit Terminal's approved access to the
# user's Documents folder. A .command file uses Terminal as the launch host
# without requesting Apple Events automation access.
if ! /usr/bin/open -a Terminal "$COMMAND_PATH"; then
  show_error "The macOS Terminal launch service was unavailable."
  exit 1
fi
